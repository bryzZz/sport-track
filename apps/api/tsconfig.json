{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@sport-track/contracts": ["../../packages/contracts/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["src", "prisma/**/*.ts"]
}
